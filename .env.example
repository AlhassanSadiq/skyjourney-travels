# SkyJourney Travels Environment Variables

# Next.js
NEXT_PUBLIC_APP_URL=https://skyjourneytravels.com

# Google Maps (for contact page map integration)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# WhatsApp Business
# NEXT_PUBLIC_WHATSAPP_NUMBER=1234567890

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Contact Form (optional - for backend integration)
# CONTACT_FORM_ENDPOINT=https://api.yourdomain.com/contact
